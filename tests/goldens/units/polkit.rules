// Generated by `session-ops polkit` from jobs.toml. Edit the registry, not this.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "opsbot" &&
        action.lookup("verb") == "start" &&
        ["session-ops@crowdin-duplicates.service", "session-ops@crowdin-sync.service"].indexOf(action.lookup("unit")) >= 0) {
        return polkit.Result.YES;
    }
});
