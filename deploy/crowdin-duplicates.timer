[Unit]
Description=Reconcile Crowdin duplicate translations daily
Documentation=https://github.com/session-foundation/session-shared-scripts

[Timer]
# Webhooks carry the day's changes; this catches whatever Crowdin failed to deliver,
# at most a day late.
OnCalendar=*-*-* 03:00 UTC
Persistent=yes
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
