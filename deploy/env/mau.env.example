# /etc/session-ops/mau.env: the monthly active users post.
# Where the figures, the reminders and the job's own failures are posted.
MAU_DISCORD_WEBHOOK_URL=
# An App Store Connect team API key with the Sales and Reports role, for Apple's opt-in
# rate: its issuer and key IDs here, its .p8 at /etc/session-ops/asc-key.p8 (mode 600).
ASC_ISSUER_ID=
ASC_KEY_ID=
