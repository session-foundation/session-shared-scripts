# /etc/session-ops/publish.env: crowdin-sync and snode-list, which publish only as the
# GitHub App. Create it under organisation settings → Developer settings → GitHub Apps:
# no webhook, repository permissions Contents and Pull requests (read and write),
# nothing else. Install it on session-android, session-ios and session-localization,
# generate a private key, and put the key where the units read it:
#     install -m 600 /dev/stdin /etc/session-ops/github-app.pem < downloaded-key.pem

GITHUB_APP_ID=
# The commits' author: the App's bot, "<slug>[bot] <<id>+<slug>[bot]@users.noreply.github.com>",
# with <id> from `gh api '/users/<slug>%5Bbot%5D' -q .id`.
PUBLISH_GIT_AUTHOR=
