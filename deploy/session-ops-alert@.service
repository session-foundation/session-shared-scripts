[Unit]
Description=Report a failed silence check to Discord
Documentation=https://github.com/session-foundation/session-shared-scripts

[Service]
Type=oneshot
User=sessionops
Group=sessionops
EnvironmentFile=/etc/session-ops/env
ExecStart=/opt/github-prs/venv/bin/python /opt/zendesk/deploy/alert.py %i
# See zendesk-alert@.service: the failed unit's journal is the line the alert quotes.
SupplementaryGroups=systemd-journal

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
